# dependencies
node_modules

# build output
dist
dist-ssr

# env — never commit secrets (.env.example is tracked on purpose)
.env*
!.env.example

# vercel
.vercel

# package-lock.json is committed by .github/workflows/lockfile.yml
# (the repo is synced through a text-only API transport that favours small
# payloads, so the lockfile is resolved and pushed by the workflow bot).
# Locally, run `npm install` once.
package-lock.json

# raster assets generated by the prebuild step (scripts/decode-assets.mjs):
# real media wins — to ship real files, remove these entries and commit them.
public/media/og.png
public/apple-touch-icon.png

# logs & misc
*.local
logs
*.log
npm-debug.log*
.DS_Store
.idea
